{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "outDir": "dist/server",
    "rootDir": ".",
    "resolveJsonModule": true
  },
  "include": ["server", "scripts"],
  "exclude": ["**/*.test.ts"]
}
