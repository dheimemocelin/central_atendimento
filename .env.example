# Use somente um banco separado para a demonstracao.
DATABASE_URL=postgresql://demo_user:CHANGE_ME@127.0.0.1:5432/crm_demo?schema=public
APP_ORIGIN=http://127.0.0.1:5173
PORT=3001
NODE_ENV=development
COOKIE_SAME_SITE=lax
SESSION_HOURS=12
# Defina senhas locais diferentes com pelo menos 12 caracteres. Sem valores padrao.
DEMO_ADMIN_PASSWORD=
DEMO_AGENT_A_PASSWORD=
DEMO_AGENT_B_PASSWORD=
# Opcional: caminho do psql para testes de integracao/E2E.
# PSQL_PATH=C:/Program Files/PostgreSQL/17/bin/psql.exe
# Opcional: origem HTTPS especifica autorizada a incorporar o CRM.
# FRAME_ANCESTOR=https://portal.example.com
