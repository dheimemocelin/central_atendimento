{
  "name": "central-atendimento-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run typecheck && node scripts/build-web.mjs && tsc -p tsconfig.server.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "start": "node dist/server/server/index.js",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "db:generate": "prisma generate",
    "db:deploy": "tsx scripts/migrate.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "backup:verify": "tsx scripts/verify-backup.ts",
    "format": "prettier --write src server scripts e2e *.ts *.json",
    "demo:seed": "tsx scripts/seed-demo.ts",
    "demo:csv": "tsx scripts/generate-demo-csv.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.6",
    "@prisma/client": "6.19.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@tanstack/react-query": "^5.90.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parse": "^7.0.3",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "fastify": "^5.6.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4",
    "recharts": "^3.3.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.1.16",
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "prettier": "^3.9.10",
    "prisma": "6.19.1",
    "tailwindcss": "^4.1.16",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "effect": "^3.20.0",
    "deepmerge-ts": "^8.0.0"
  },
  "description": "CRM demonstrativo com Kanban, permissões e BI usando dados sintéticos."
}
